# Copy to .env.local and fill in values

# API base URL for production (leave empty in dev — Vite proxy handles /api)
VITE_API_BASE_URL=

# Vite dev server proxy hedefi.
#   docker compose ile:  http://localhost:5188
#   IDE https profili:   https://localhost:7118 (varsayılan)
VITE_API_TARGET=https://localhost:7118
