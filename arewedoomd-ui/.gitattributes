# Enforce LF line endings for all text files
* text=auto eol=lf

# Explicitly mark common text file types
*.js      text eol=lf
*.jsx     text eol=lf
*.ts      text eol=lf
*.tsx     text eol=lf
*.css     text eol=lf
*.html    text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.env     text eol=lf
*.env.*   text eol=lf
*.sh      text eol=lf

# Binary files — never touch line endings
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.svg     binary
*.woff    binary
*.woff2   binary
*.ttf     binary
*.eot     binary
*.webp    binary
